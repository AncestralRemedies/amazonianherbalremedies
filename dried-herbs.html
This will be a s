<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Dried Herbs | Amazonian Herbal Remedies</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Lato:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: 'Lato', sans-serif;
      background: #FAF7F0;
      color: #263d2b;
      line-height: 1.6;
    }

    header {
      background: #465746;
      color: #FAF7F0;
      text-align: center;
      padding: 48px 18px 40px;
      border-bottom: 2px solid #C6A96B;
    }

    header h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 38px;
      margin: 0;
    }

    header p {
      margin: 8px 0 0;
    }

    nav {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 22px;
      padding: 16px;
      background: #FAF7F0;
    }

    nav a {
      color: #263d2b;
      text-decoration: none;
      font-weight: 600;
    }

    nav a:hover {
      color: #A98B50;
    }

    .search-cart-bar {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      padding: 18px;
    }

    .store-search {
      width: 100%;
      max-width: 350px;
      padding: 12px;
      border: 1px solid #C6A96B;
      border-radius: 6px;
      background: white;
    }

    button {
      cursor: pointer;
      font-family: 'Lato', sans-serif;
    }

    .cart-button,
    .button {
      background: #465746;
      color: #FAF7F0;
      border: 1px solid #C6A96B;
      padding: 12px 20px;
      border-radius: 5px;
      text-decoration: none;
    }

    .cart-panel {
      display: none;
      max-width: 500px;
      margin: 10px auto 25px;
      padding: 22px;
      background: #fff;
      border: 1px solid #C6A96B;
      border-radius: 8px;
    }

    .cart-panel.active {
      display: block;
    }

    main {
      max-width: 1100px;
      margin: auto;
      padding: 25px 18px 50px;
    }

    .page-intro {
      text-align: center;
      padding: 45px 15px;
      background: #F1EEE4;
      border-radius: 8px;
      margin-bottom: 35px;
    }

    h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 34px;
      color: #465746;
    }

    .page-intro p {
      max-width: 650px;
      margin: 10px auto;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 22px;
    }

    .product {
      background: #fff;
      border: 1px solid #E5DDCC;
      border-radius: 8px;
      padding: 25px;
      text-align: center;
    }

    .product-placeholder {
      min-height: 150px;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #F1EEE4;
      border-radius: 6px;
      color: #788675;
      font-size: 40px;
    }

    .about-note {
      text-align: center;
      padding: 35px 15px;
    }

    footer {
      background: #465746;
      color: #FAF7F0;
      text-align: center;
      padding: 25px 15px;
      border-top: 2px solid #C6A96B;
    }

    @media (max-width: 600px) {
      header h1 {
        font-size: 30px;
      }

      nav {
        gap: 14px;
      }

      .store-search {
        min-width: 100%;
      }
    }
  </style>
</head>

<body>

  <header>
    <h1>Amazonian Herbal Remedies</h1>
    <p>Nature's Heritage. Rooted in Tradition.</p>
  </header>

  <nav>
    <a href="index.html#home">Home</a>
    <a href="index.html#products">Our Herbs</a>
    <a href="index.html#about">About Us</a>
    <a href="index.html#contact">Contact</a>
  </nav>

  <div class="search-cart-bar">
    <input
      type="search"
      id="productSearch"
      class="store-search"
      placeholder="Search dried herbs..."
      aria-label="Search dried herbs"
    >

    <button class="cart-button" onclick="toggleCart()">
      🛒 My Cart (<span id="cartCount">0</span>)
    </button>
  </div>

  <div id="cartPanel" class="cart-panel">
    <h2>Your Shopping Cart</h2>
    <div id="cartItems">
      Your cart is currently empty.
    </div>
    <p><strong id="cartTotal">Total: $0.00</strong></p>
    <button class="button" onclick="goToCheckout()">
      Proceed to Order
    </button>
  </div>

  <main>

    <section class="page-intro">
      <h2>Dried Herbs</h2>
      <p>
        Explore our collection of dried botanical ingredients,
        inspired by the rich plant heritage of Guyana and the Amazon.
      </p>
      <p>Nature's treasures, thoughtfully shared.</p>
    </section>

    <section id="driedHerbProducts">
      <h2 style="text-align: center;">Our Dried Herbs Collection</h2>

      <div class="products">

        <div class="product">
          <div class="product-placeholder">🌿</div>
          <h3>Our Dried Herbs</h3>
          <p>Our botanical collection will be featured here soon.</p>
        </div>

      </div>
    </section>

    <section class="about-note">
      <p>More botanical treasures are coming soon.</p>
      <a class="button" href="index.html#products">
        Back to Our Collection
      </a>
    </section>

  </main>

  <footer>
    <p>© 2026 Amazonian Herbal Remedies</p>
    <p>Botanical heritage, thoughtfully shared.</p>
  </footer>

  <script>
    const CART_KEY = 'amazonianHerbalCart';

    let shoppingCart = JSON.parse(
      localStorage.getItem(CART_KEY) || '[]'
    );

    function saveCart() {
      localStorage.setItem(
        CART_KEY,
        JSON.stringify(shoppingCart)
      );
    }

    function toggleCart() {
      document.getElementById('cartPanel')
        .classList.toggle('active');
    }

    function renderCart() {
      const cartItems = document.getElementById('cartItems');
      const cartCount = document.getElementById('cartCount');

      const count = shoppingCart.reduce(
        (sum, item) => sum + item.quantity, 0
      );

      const total = shoppingCart.reduce(
        (sum, item) => sum + item.price * item.quantity, 0
      );

      cartCount.textContent = count;
      cartItems.innerHTML = '';

      if (shoppingCart.length === 0) {
        cartItems.textContent = 'Your cart is currently empty.';
      }

      shoppingCart.forEach((item, index) => {
        const row = document.createElement('p');

        row.textContent =
          item.name + ' - Quantity: ' + item.quantity;

        cartItems.appendChild(row);
      });

      document.getElementById('cartTotal').textContent =
        'Total: $' + total.toFixed(2);
    }

    function goToCheckout() {
      if (shoppingCart.length === 0) {
        alert('Your shopping cart is empty.');
        return;
      }

      saveCart();
      window.location.href = 'index.html#order';
    }

    document.getElementById('productSearch')
      .addEventListener('input', function() {
        const search = this.value.toLowerCase();

        document.querySelectorAll('.product').forEach(product => {
          product.style.display =
            product.textContent.toLowerCase().includes(search)
              ? ''
              : 'none';
        });
      });

    renderCart();
  </script>

</body>
</html>